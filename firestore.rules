rules_version = '2';

// NexusBoard Firestore rules.
// The game server uses the Admin SDK, which bypasses these rules entirely —
// they only govern clients (Android app, website). Server-owned collections
// are write-locked; players can read only their own documents.
service cloud.firestore {
  match /databases/{database}/documents {

    // Login sessions created by taps. The app listens for its own latest
    // session to pick up the redemption code. Created/updated by the server.
    match /tap_sessions/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Single-use HCE tap codes. Server-only: the app never reads these,
    // it transmits the code value it was given over NFC.
    match /hce_tokens/{doc} {
      allow read, write: if false;
    }

    // RFID card -> player assignments. Managed by staff tooling (server).
    match /cards/{doc} {
      allow read, write: if false;
    }

    // Player profiles. A player reads their own doc; cluster assignment
    // and roles change only through staff/admin backend operations.
    match /users/{doc} {
      allow read: if request.auth != null && request.auth.uid == doc;
      allow create: if request.auth != null && request.auth.uid == doc
                    && !request.resource.data.keys().hasAny(['clusterId', 'role']);
      allow update, delete: if false;
    }

    // Cluster registry (boards, staff, membership metadata).
    match /clusters/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Recorded games for spectating/replay. Any signed-in user can watch;
    // only the server records.
    match /games/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Friendships: one doc per relationship. Only the requester can create
    // (always as pending), only the addressee can accept, either side can
    // delete (decline / unfriend).
    match /friendships/{doc} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.users
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'accepted'
                    && resource.data.requestedBy != request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Challenges: a party-code invite from one player to another. Only the
    // challenger creates (pending), the challenged declines (with an
    // optional reason) or accepts, the challenger may expire a stale
    // challenge, and either can delete.
    match /challenges/{doc} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from
                      || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (request.auth.uid == resource.data.to
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'declineReason']))
        ||
        (request.auth.uid == resource.data.from
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
          && request.resource.data.status == 'expired')
      );
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from
                        || request.auth.uid == resource.data.to);
    }
  }
}
