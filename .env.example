# Copy this file to .env and fill in real values. .env is gitignored.

# Firebase Admin SDK credentials (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Keep the \n escapes in the key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public URL that tap login links point at
PUBLIC_BASE_URL=http://localhost:8080

# Station credentials — one per machine (generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
STATION_A_SECRET=replace-me

# Optional: bind a station to a NexusBoard cluster so only its members can tap in
# STATION_A_CLUSTER=cluster_001

# NexusBoard Flask backend -> POST /bridge/tap (Authorization: Bearer ...)
BRIDGE_SECRET=replace-me

# Force guest kiosk mode (solo vs robot, no sign-in) even when Firebase
# credentials exist. With no credentials at all this is automatic.
# OFFLINE=1

# Tap session tuning (defaults shown): browser-loss grace before the session
# ends, and maximum lifetime of a redeemed session
# SESSION_GRACE_MS=90000
# SESSION_MAX_MS=7200000
# REDEEM_TTL_MS=300000   one-time code validity (5 min; shorten for tests)

# Station watcher (Xiangqi camera/arm backend): polls the read-only API and
# projects each station's game into a spectatable, recorded "virtual room".
# XQ_API_BASE=https://his-server.example.com
# XQ_READER_ID=reader-name
# XQ_READER_KEY=reader-key
# XQ_DEVICES=deviceId1:Station A,deviceId2:Station B
# XQ_POLL_MS=2500
